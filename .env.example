# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
GROQ_API_KEY=gsk_your_api_key_here

# --- LLM --------------------------------------------------------------------
LLM_MODEL=openai/gpt-oss-120b
# Judge and critic run on different model families than the generator
# (reduces self-preference bias and spreads per-model rate limits)
JUDGE_MODEL=qwen/qwen3.8-27b
CRITIC_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_MAX_WAIT_S=45
GENERATION_TEMPERATURE=0.1

# Optional cost estimate (USD per 1M tokens). Check your provider's current
# pricing; leave unset to hide cost estimates.
# PRICE_PROMPT_PER_1M=
# PRICE_COMPLETION_PER_1M=

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
# Documents in this folder are ingested at startup (skips duplicates)
# SEED_DIR=./seed_docs

# --- Ingestion / retrieval --------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=100
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
FINAL_TOP_K=5
RERANK_CANDIDATES=10
RERANKER_MAX_LENGTH=256
RERANKER_ENABLED=true
MIN_RERANK_SCORE=-5.0
MIN_DENSE_SCORE=0.25
QUERY_REWRITE_ENABLED=true

# --- Reliability loop -------------------------------------------------------
FAITHFULNESS_THRESHOLD=0.80
RELEVANCE_THRESHOLD=0.70
COMPLETENESS_THRESHOLD=0.60
FAIL_ON_UNSUPPORTED_CLAIMS=true
MAX_RETRIES=2

# --- Service ----------------------------------------------------------------
WARMUP_MODELS=true
LOG_LEVEL=INFO
LOG_JSON=true
# Include query text / claim excerpts in logs (set false where logs must not hold user content)
LOG_CONTENT=true
# JSON list; restrict to your UI origin in production
# CORS_ORIGINS=["https://your-ui.example.com"]
# Optional shared password for the UI (recommended for any public deployment)
# APP_PASSWORD=
# UI backend: http (default, calls the API below) or embedded (runs the pipeline inside Streamlit)
# RAG_BACKEND=http
# Used by the Streamlit UI to reach the API
API_BASE_URL=http://localhost:8000
